# Android app build: put these in .env.local (git-ignored). They are baked into the APK.
# Use a Turso token created with an expiry/limited scope; anyone with the APK can extract it.
VITE_TURSO_DATABASE_URL=
VITE_TURSO_AUTH_TOKEN=

# Used only by scripts (migrate-to-turso, create-user):
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional: custom local SQLite file path for the scripts
# SQLITE_PATH=data/jataka.db
